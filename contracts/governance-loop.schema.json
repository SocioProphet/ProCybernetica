{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/procybernetica/governance-loop.schema.json",
  "title": "Cybernetic Governance Loop Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "loop_id",
    "service_id",
    "state",
    "decision_authority",
    "escalation_boundary",
    "receipt_requirements"
  ],
  "properties": {
    "loop_id": {
      "type": "string",
      "pattern": "^govloop\\.[a-z0-9][a-z0-9.-]*$"
    },
    "service_id": {
      "type": "string",
      "const": "svc.platform.cybernetic-governance"
    },
    "state": {
      "type": "string",
      "enum": ["observe", "orient", "decide", "act", "review", "override", "escalate"]
    },
    "decision_authority": {
      "type": "string",
      "enum": ["local-agent", "workspace-controller", "policy-guardrail", "human-operator", "governance-board"]
    },
    "escalation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "target_authority"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "target_authority": {"type": "string", "minLength": 1},
        "max_latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "override_rules": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "receipt_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["policy-decision-receipt", "evidence-receipt", "operator-override-receipt", "governance-feedback-receipt"]
      }
    }
  }
}
