{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/civic_audit_signal.v1.json",
  "title": "Civic Audit Signal",
  "description": "Audit completeness and scoreability signal for Delivery Excellence scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_signal_id", "audit_finding_ref", "scoreability_status", "completeness", "dimensions", "delivery_excellence_score_ref", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit_signal_id": {"type": "string", "minLength": 1},
    "audit_finding_ref": {"type": "string", "minLength": 1},
    "scoreability_status": {"enum": ["scoreable", "partial", "not_scoreable", "withheld"]},
    "completeness": {"type": "number", "minimum": 0, "maximum": 1},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_completeness", "control_coverage", "provenance_completeness", "redaction_status", "runtime_attestation_coverage", "policy_decision_coverage", "open_gap_count"],
      "properties": {
        "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "control_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "redaction_status": {"enum": ["public", "public_synthetic", "public_sanitized", "withheld", "sealed"]},
        "runtime_attestation_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "policy_decision_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "open_gap_count": {"type": "integer", "minimum": 0}
      }
    },
    "delivery_excellence_score_ref": {"type": "string", "minLength": 1},
    "evidence_pack_ref": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
