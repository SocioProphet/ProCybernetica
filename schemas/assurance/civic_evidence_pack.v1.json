{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/civic_evidence_pack.v1.json",
  "title": "Civic Evidence Pack",
  "description": "Evidence pack for civic-stack service, dataset, runtime, policy, or artifact decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_pack_id", "decision_target", "civic_layer", "object_ref", "risk_control_binding_refs", "artifact_entry_refs", "proof_pack_refs", "evidence_receipt_refs", "redaction_status", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_pack_id": {"type": "string", "minLength": 1},
    "decision_target": {"enum": ["service_decision", "dataset_decision", "runtime_decision", "policy_decision", "artifact_decision"]},
    "civic_layer": {"enum": ["CGRM", "SRM", "DRM", "TRM", "OAC"]},
    "object_ref": {"type": "string", "minLength": 1},
    "risk_control_binding_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact_entry_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proof_pack_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "attestation_refs": {"type": "array", "items": {"type": "string"}},
    "runtime_assurance_refs": {"type": "array", "items": {"type": "string"}},
    "supply_chain_refs": {"type": "array", "items": {"type": "string"}},
    "policy_decision_refs": {"type": "array", "items": {"type": "string"}},
    "audit_signal_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "redaction_status": {"enum": ["public", "public_synthetic", "public_sanitized", "withheld", "sealed"]},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
