{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/civic_risk_contribution.v1.json",
  "title": "Civic Risk Contribution",
  "description": "RationalGRL-facing negative contribution, blocker, defeater, or conflict for civic risk/control assurance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "risk_contribution_id", "semantic_anchor_ref", "contribution_kind", "source_ref", "target_ref", "rationale", "risk_control_binding_ref", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "risk_contribution_id": {"type": "string", "minLength": 1},
    "semantic_anchor_ref": {"type": "string", "minLength": 1},
    "contribution_kind": {"enum": ["negative_contribution", "blocker", "defeater", "conflict"]},
    "source_ref": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "risk_control_binding_ref": {"type": "string", "minLength": 1},
    "threat_model_ref": {"type": "string"},
    "policy_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
