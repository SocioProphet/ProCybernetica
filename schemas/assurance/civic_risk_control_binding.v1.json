{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/civic_risk_control_binding.v1.json",
  "title": "Civic Risk Control Binding",
  "description": "Assurance binding between civic-stack object families, risks, controls, and evidence references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "civic_layer", "object_family", "object_ref", "risk_ref", "risk_severity", "control_ref", "control_objective", "resilience_target_ref", "evidence_pack_ref", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "binding_id": {"type": "string", "minLength": 1},
    "civic_layer": {"enum": ["CGRM", "SRM", "DRM", "TRM", "OAC"]},
    "object_family": {"enum": ["Risk", "Control", "IncidentEvent", "AttestationEvent", "EvidencePack", "AuditFinding", "ThreatModel", "ResilienceTarget", "Service", "Dataset", "Runtime", "Policy", "Artifact"]},
    "object_ref": {"type": "string", "minLength": 1},
    "risk_ref": {"type": "string", "minLength": 1},
    "risk_severity": {"enum": ["low", "medium", "high", "critical", "unknown"]},
    "control_ref": {"type": "string", "minLength": 1},
    "control_objective": {"type": "string", "minLength": 1},
    "control_status": {"enum": ["proposed", "implemented", "verified", "failed", "waived", "unknown"], "default": "proposed"},
    "resilience_target_ref": {"type": "string", "minLength": 1},
    "policy_refs": {"type": "array", "items": {"type": "string"}},
    "threat_model_refs": {"type": "array", "items": {"type": "string"}},
    "rational_grl_contribution_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_pack_ref": {"type": "string", "minLength": 1},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance_refs": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
