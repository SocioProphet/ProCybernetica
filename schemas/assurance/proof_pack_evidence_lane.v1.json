{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/proof_pack_evidence_lane.v1.json",
  "title": "Proof Pack Evidence Lane",
  "description": "Evidence-lane summary for proof-pack reviewer packets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_lane_id", "lane", "artifact_entry_refs", "coverage_status", "evidence_receipt_refs", "known_gaps", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_lane_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["product_efficacy", "governance_control", "customer_delivery_adoption", "market_proof", "upstream_aligned_exhibit", "redaction_handling", "reviewer_disposition"]},
    "artifact_entry_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "coverage_status": {"enum": ["complete", "partial", "missing", "not_applicable", "withheld"]},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "score_weight": {"type": "number", "minimum": 0},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
