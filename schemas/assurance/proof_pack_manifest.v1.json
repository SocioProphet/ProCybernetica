{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/proof_pack_manifest.v1.json",
  "title": "Proof Pack Manifest",
  "description": "Reviewer-facing proof-pack manifest collecting evidence lanes, artifact entries, redaction statuses, claim discipline records, scorecard, and disposition references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof_pack_id", "review_name", "review_date", "reviewer_ref", "deployment_context", "artifact_entry_refs", "evidence_lane_refs", "redaction_status_refs", "claim_discipline_refs", "scorecard_ref", "disposition_ref", "evidence_receipt_refs", "known_excluded_claims", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proof_pack_id": {"type": "string", "minLength": 1},
    "review_name": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "format": "date"},
    "reviewer_ref": {"type": "string", "minLength": 1},
    "deployment_context": {"type": "string", "minLength": 1},
    "product_or_capability_ref": {"type": "string"},
    "weighting_model": {"enum": ["default_enterprise", "regulated_variant", "custom"]},
    "primary_use_case": {"type": "string"},
    "primary_risks": {"type": "array", "items": {"type": "string"}},
    "artifact_entry_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_lane_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "redaction_status_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claim_discipline_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scorecard_ref": {"type": "string", "minLength": 1},
    "disposition_ref": {"type": "string", "minLength": 1},
    "agentplane_proof_pack_exhibit_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "release_delta_report_refs": {"type": "array", "items": {"type": "string"}},
    "cybernetic_safety_case_refs": {"type": "array", "items": {"type": "string"}},
    "artifact_provenance_refs": {"type": "array", "items": {"type": "string"}},
    "known_excluded_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
