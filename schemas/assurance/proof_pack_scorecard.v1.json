{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/assurance/proof_pack_scorecard.v1.json",
  "title": "Proof Pack Scorecard",
  "description": "Reviewer scorecard for proof-pack evidence lanes and claim discipline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scorecard_id", "proof_pack_ref", "lane_scores", "claim_discipline_refs", "overall_verdict", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scorecard_id": {"type": "string", "minLength": 1},
    "proof_pack_ref": {"type": "string", "minLength": 1},
    "lane_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "score", "evidence_lane_ref", "verdict"],
        "properties": {
          "lane": {"enum": ["product_efficacy", "governance_control", "customer_delivery_adoption", "market_proof", "upstream_aligned_exhibit", "redaction_handling", "reviewer_disposition"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_lane_ref": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["pass", "warn", "fail", "not_applicable", "review_required"]},
          "reviewer_note": {"type": "string"}
        }
      }
    },
    "claim_discipline_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "overall_verdict": {"enum": ["accept", "conditional_accept", "hold", "reject", "review_required"]},
    "confidence_bound": {"enum": ["low", "moderate", "high", "unknown"]},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
