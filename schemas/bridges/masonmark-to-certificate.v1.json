{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/bridges/masonmark-to-certificate.v1.json",
  "title": "Masonmark to Certificate Bridge",
  "description": "Bridge record mapping a Masonmark proofpack to certificate-state without mutating certificate-family schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bridge_id",
    "masonmark_proofpack_ref",
    "proofpack_state",
    "pattern_class",
    "certificate_projection",
    "verifier_scores",
    "evidence_receipt_refs",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bridge_id": {"type": "string", "minLength": 1},
    "masonmark_proofpack_ref": {"type": "string", "minLength": 1},
    "proofpack_state": {"enum": ["candidate", "verified", "rejected", "superseded", "undecided"]},
    "pattern_class": {"enum": ["pattern_a", "pattern_b", "pattern_c", "unknown"]},
    "certificate_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_ref", "certificate_family", "promotion_state", "verdict"],
      "properties": {
        "certificate_ref": {"type": "string", "minLength": 1},
        "certificate_family": {"enum": ["M0", "M1A", "M1B", "M1C", "M1_5", "M1D", "M1", "M2", "M3", "M5", "safety_case"]},
        "promotion_state": {"enum": ["candidate", "promoted_stele", "rejected", "superseded", "undecided"]},
        "verdict": {"enum": ["allow", "deny", "review_required", "undecided"]}
      }
    },
    "verifier_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soundness", "traceability", "non_claim_integrity"],
      "properties": {
        "soundness": {"type": "number", "minimum": 0, "maximum": 1},
        "traceability": {"type": "number", "minimum": 0, "maximum": 1},
        "non_claim_integrity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "reasoning_trace_ref": {"type": "string"},
    "authority_chain_ref": {"type": "string"},
    "capability_tier_invocation": {"type": "object"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
