{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/certificates/base-certificate.v1.3.json",
  "title": "Base Certificate v1.3",
  "description": "Shared certificate-family structure for M0-M5 and ProCybernetica safety-case certificates. Adds authority_layer, promotion_state, reasoning_trace_ref, and cadence_classification while preserving backward-compatible extensibility.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "certificate_kind",
    "certificate_id",
    "ts_issued",
    "subject",
    "verdict_status",
    "authority_layer",
    "promotion_state",
    "reasoning_trace_ref",
    "cadence_classification",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "certificate_kind": {
      "enum": [
        "m0-training-provenance",
        "m1a-source-lock",
        "m1b-witness-card",
        "m1c-causal-triad",
        "m1-5-attribution-graph",
        "m1d-off-target-audit",
        "m1-composite",
        "m2-implementability",
        "m3-cross-layer-robustness",
        "m5-public-note",
        "procybernetica-safety-case"
      ]
    },
    "certificate_id": {"type": "string", "minLength": 1},
    "ts_issued": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifact_id", "artifact_kind", "artifact_content_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_kind": {"type": "string", "minLength": 1},
        "artifact_content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "verdict_status": {"enum": ["undecided", "admitted", "rejected", "superseded", "review_required"]},
    "authority_layer": {"enum": ["draft", "grounded_schema", "human_review", "institutional_truth", "runtime_evidence", "public_note"]},
    "promotion_state": {"enum": ["candidate", "promoted_stele", "rejected", "superseded"]},
    "reasoning_trace_ref": {"type": ["object", "string", "null"]},
    "cadence_classification": {"enum": ["microbeat", "mesobeat", "macrobeats", "macrobeat", "event_driven", "unknown"]},
    "stele_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "successor_certificate_ref": {"type": ["object", "string", "null"]},
    "signing_authority_chain": {"type": "array", "items": {"type": "object"}},
    "authority_concentration_index": {"type": ["object", "null"]},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"promotion_state": {"const": "candidate"}}, "required": ["promotion_state"]},
      "then": {
        "properties": {
          "verdict_status": {"enum": ["undecided", "review_required"]},
          "reasoning_trace_ref": {"type": ["null", "object", "string"]}
        }
      }
    },
    {
      "if": {"properties": {"promotion_state": {"const": "promoted_stele"}}, "required": ["promotion_state"]},
      "then": {
        "properties": {"verdict_status": {"const": "admitted"}},
        "required": ["reasoning_trace_ref", "signing_authority_chain"]
      }
    },
    {
      "if": {"properties": {"promotion_state": {"const": "rejected"}}, "required": ["promotion_state"]},
      "then": {"properties": {"verdict_status": {"const": "rejected"}}}
    },
    {
      "if": {"properties": {"promotion_state": {"const": "superseded"}}, "required": ["promotion_state"]},
      "then": {"properties": {"verdict_status": {"const": "superseded"}}, "anyOf": [{"required": ["successor_certificate_ref"]}, {"required": ["supersedes"]}]}
    }
  ]
}
