{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/agentic_post_hoc_eval.v1.json",
  "title": "Agentic Post-Hoc Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "post_hoc_eval_id", "cmdp_trace_ref", "completion_verdict", "budget_verdict", "safety_verdict", "evidence_receipt_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "post_hoc_eval_id": {"type": "string", "minLength": 1},
    "cmdp_trace_ref": {"type": "string", "minLength": 1},
    "completion_verdict": {"enum": ["complete", "partial", "failed", "inconclusive"]},
    "budget_verdict": {"enum": ["within_budget", "degraded", "overflow", "unknown"]},
    "safety_verdict": {"enum": ["pass", "warn", "fail", "manual_review"]},
    "persona_policy_ref": {"type": "string"},
    "task_budget_ref": {"type": "string"},
    "degradation_event_refs": {"type": "array", "items": {"type": "string"}},
    "loop_detector_signal_refs": {"type": "array", "items": {"type": "string"}},
    "proof_pack_exhibit_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
