{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/agentic_task_budget.v1.json",
  "title": "Agentic Task Budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_budget_id", "persona_policy_ref", "budget", "evidence_receipt_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_budget_id": {"type": "string", "minLength": 1},
    "persona_policy_ref": {"type": "string", "minLength": 1},
    "workload_signature_ref": {"type": "string"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens_in_max", "tokens_out_max", "tool_calls_max", "wall_clock_seconds_max", "dollars_max"],
      "properties": {
        "tokens_in_max": {"type": "integer", "minimum": 0},
        "tokens_out_max": {"type": "integer", "minimum": 0},
        "tool_calls_max": {"type": "integer", "minimum": 0},
        "wall_clock_seconds_max": {"type": "number", "minimum": 0},
        "dollars_max": {"type": "number", "minimum": 0}
      }
    },
    "chance_constraints": {"type": "object"},
    "authority_chain_ref": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
