{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/agentic_uco_step_cost.v1.json",
  "title": "Agentic UCO Step Cost",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "step_cost_id", "run_ref", "step_index", "uco", "evidence_receipt_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "step_cost_id": {"type": "string", "minLength": 1},
    "run_ref": {"type": "string", "minLength": 1},
    "step_index": {"type": "integer", "minimum": 0},
    "persona_policy_ref": {"type": "string"},
    "workload_signature_ref": {"type": "string"},
    "uco": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "cache_read_tokens", "tool_call_units", "verification_tokens", "estimated_dollars"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "tool_call_units": {"type": "integer", "minimum": 0},
        "tool_call_latency_ms": {"type": "number", "minimum": 0},
        "verification_tokens": {"type": "integer", "minimum": 0},
        "replay_storage_bytes": {"type": "integer", "minimum": 0},
        "semantic_memory_write_units": {"type": "integer", "minimum": 0},
        "estimated_dollars": {"type": "number", "minimum": 0}
      }
    },
    "authority_chain_ref": {"type": "string"},
    "agent_action_trace_ref": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
