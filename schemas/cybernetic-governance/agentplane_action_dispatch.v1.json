{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/agentplane_action_dispatch.v1.json",
  "title": "AgentPlane Action Dispatch",
  "description": "Governance binding record for an AgentPlane action dispatch attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dispatch_id", "run_capsule_ref", "agent_id", "action_ref", "dispatch_status", "authority_chain_ref", "tool_grant_ref", "agent_action_trace_ref", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "run_capsule_ref": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "action_ref": {"type": "string", "minLength": 1},
    "dispatch_status": {"enum": ["dispatched", "completed", "blocked", "transformed", "review_required", "failed"]},
    "authority_chain_ref": {"type": "string", "minLength": 1},
    "tool_grant_ref": {"type": "string", "minLength": 1},
    "tool_permission_scope_ref": {"type": "string"},
    "agent_action_trace_ref": {"type": "string", "minLength": 1},
    "side_effect_assessment_ref": {"type": "string"},
    "environment_delta_ref": {"type": "string"},
    "monitor_alert_refs": {"type": "array", "items": {"type": "string"}},
    "control_decision_refs": {"type": "array", "items": {"type": "string"}},
    "off_history_evidence_ref": {"type": ["string", "null"]},
    "safe_alternative_ref": {"type": ["string", "null"]},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
