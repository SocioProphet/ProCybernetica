{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/agentplane_subagent_delegation.v1.json",
  "title": "AgentPlane Subagent Delegation",
  "description": "Governance record for bounded AgentPlane subagent delegation without ambient authority inheritance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delegation_id", "run_capsule_ref", "parent_agent_id", "subagent_id", "delegated_goal", "delegated_authority_scope", "authority_chain_ref", "inherited_policy_refs", "forbidden_escalations", "tool_grant_refs", "return_evidence_requirements", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "delegation_id": {"type": "string", "minLength": 1},
    "run_capsule_ref": {"type": "string", "minLength": 1},
    "parent_agent_id": {"type": "string", "minLength": 1},
    "subagent_id": {"type": "string", "minLength": 1},
    "delegated_goal": {"type": "string", "minLength": 1},
    "delegated_authority_scope": {"type": "string", "minLength": 1},
    "authority_chain_ref": {"type": "string", "minLength": 1},
    "inherited_policy_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_escalations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tool_grant_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "monitoring_requirements": {"type": "array", "items": {"type": "string"}},
    "return_evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
