{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/agentplane_tool_grant.v1.json",
  "title": "AgentPlane Tool Grant",
  "description": "Governance record for an AgentPlane tool grant before execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_grant_id", "agent_id", "tool_id", "grant_scope", "authority_chain_ref", "allowed_actions", "forbidden_actions", "side_effect_budget", "revocation_status", "evidence_receipt_refs", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool_grant_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "tool_id": {"type": "string", "minLength": 1},
    "grant_scope": {"type": "string", "minLength": 1},
    "authority_chain_ref": {"type": "string", "minLength": 1},
    "tool_permission_scope_ref": {"type": "string"},
    "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "side_effect_budget": {"enum": ["none", "read_only", "reversible", "compensable", "irreversible_requires_approval"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "approval_ref": {"type": ["string", "null"]},
    "revocation_status": {"enum": ["active", "revoked", "expired", "suspended"]},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
