{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/authority_chain.v1.json",
  "title": "Authority Chain",
  "description": "Explicit authority path for a governed decision, action, evidence object, or promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_chain_id", "subject_ref", "decision_scope", "authority_steps", "effective_authority", "implements_invariants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "authority_chain_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "decision_scope": {"type": "string", "minLength": 1},
    "authority_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "authority_type", "issuer_ref", "policy_ref"],
        "properties": {
          "step_id": {"type": "string"},
          "authority_type": {"type": "string"},
          "issuer_ref": {"type": "string"},
          "policy_ref": {"type": "string"},
          "evidence_receipt_ref": {"type": "string"}
        }
      }
    },
    "effective_authority": {"type": "string", "enum": ["allowed", "allowed_with_conditions", "denied", "unknown"]},
    "conflict_refs": {"type": "array", "items": {"type": "string"}},
    "implements_invariants": {"type": "array", "minItems": 1, "items": {"$ref": "enums.v1.json#/$defs/constitutional_invariant_id"}},
    "notes": {"type": "string"}
  },
  "examples": [{"schema_version": "1.0", "authority_chain_id": "authority:demo:1", "subject_ref": "action:demo:1", "decision_scope": "file-write", "authority_steps": [{"step_id": "step:1", "authority_type": "operator", "issuer_ref": "user:demo", "policy_ref": "policy:demo"}], "effective_authority": "allowed", "implements_invariants": ["invariant_0_1_no_hidden_authority_lane"]}]
}
