{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/channel_observation.v1.json",
  "title": "Channel Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "channel", "percept", "confidence", "provenance_ref", "authority_envelope_ref", "promotion_state", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "observation_id": {"type": "string", "pattern": "^rcg:observation:[a-z0-9][a-z0-9_.:-]*$"},
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "channel_class", "substrate", "producer", "consumer", "capture_method", "trust_boundary", "known_confusability_modes"],
      "properties": {
        "channel_id": {"type": "string", "pattern": "^rcg:channel:[a-z0-9][a-z0-9_.:-]*$"},
        "channel_class": {"enum": ["human_sense", "human_communication", "machine_observability", "connector", "model_output", "memory_retrieval", "graph_projection", "dashboard_projection", "agent_report", "action_path"]},
        "substrate": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "consumer": {"type": "string", "minLength": 1},
        "capture_method": {"type": "string", "minLength": 1},
        "trust_boundary": {"enum": ["same_process", "same_workspace", "same_org", "external_authenticated", "external_public", "synthetic", "adversarial_or_unknown"]},
        "known_confusability_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "percept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percept_kind", "rendering", "loss_profile"],
      "properties": {
        "percept_kind": {"enum": ["transcript", "parsed_event", "summary", "dashboard_panel", "graph_slice", "memory_card", "model_answer", "sensor_reading", "operator_input", "artifact_diff"]},
        "rendering": {"type": "string", "minLength": 1},
        "loss_profile": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence_type", "level"],
      "properties": {
        "confidence_type": {"enum": ["acoustic", "visual", "semantic", "provenance", "statistical", "operational", "graph_extraction", "model_heuristic", "human_reported", "artifact_verified"]},
        "level": {"enum": ["low", "medium", "high", "unknown"]},
        "rationale": {"type": "string"}
      }
    },
    "provenance_ref": {"type": "string", "minLength": 1},
    "authority_envelope_ref": {"type": "string", "pattern": "^rcg:authority:[a-z0-9][a-z0-9_.:-]*$"},
    "promotion_state": {"enum": ["raw_observation", "candidate", "confirmed", "contested", "superseded", "expired"]},
    "repair_protocols": {"type": "array", "items": {"type": "string"}, "default": []},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  }
}
