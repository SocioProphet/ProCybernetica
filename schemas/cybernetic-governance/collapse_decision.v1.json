{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/collapse_decision.v1.json",
  "title": "Collapse Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collapse_id", "source_observation_ref", "candidate_interpretants", "selected_interpretant_ref", "decision_basis", "authority_envelope_ref", "downstream_sink", "reversibility", "repair_event_refs", "residual_uncertainty", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "collapse_id": {"type": "string", "pattern": "^rcg:collapse:[a-z0-9][a-z0-9_.:-]*$"},
    "source_observation_ref": {"type": "string", "pattern": "^rcg:observation:[a-z0-9][a-z0-9_.:-]*$"},
    "candidate_interpretants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^rcg:interpretant:[a-z0-9][a-z0-9_.:-]*$"}},
    "selected_interpretant_ref": {"type": "string", "pattern": "^rcg:interpretant:[a-z0-9][a-z0-9_.:-]*$"},
    "decision_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_envelope_ref": {"type": "string", "pattern": "^rcg:authority:[a-z0-9][a-z0-9_.:-]*$"},
    "downstream_sink": {"enum": ["display", "suggest", "candidate_memory", "confirmed_memory", "graph_edge", "claim_proposal", "claim_promotion", "policy_binding", "reversible_action", "high_risk_action", "publish", "delete", "authorize_agent"]},
    "reversibility": {"enum": ["reversible", "partially_reversible", "irreversible", "unknown"]},
    "repair_event_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rcg:repair:[a-z0-9][a-z0-9_.:-]*$"}},
    "residual_uncertainty": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  }
}
