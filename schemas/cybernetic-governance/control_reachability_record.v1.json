{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/control_reachability_record.v1.json",
  "title": "Control Reachability Record",
  "description": "Record answering which control inputs can affect which downstream observables and whether a path is allowed, blocked, transformed, or unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reachability_record_id", "dependency_graph_ref", "control_ref", "observable_ref", "reachability", "path_refs", "evidence_receipt_refs", "safety_case_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reachability_record_id": {"type": "string", "minLength": 1},
    "dependency_graph_ref": {"type": "string", "minLength": 1},
    "control_ref": {"type": "string", "minLength": 1},
    "observable_ref": {"type": "string", "minLength": 1},
    "reachability": {"enum": ["reachable", "blocked", "transformed", "partition_hidden", "unknown"]},
    "path_refs": {"type": "array", "items": {"type": "string"}},
    "authority_chain_ref": {"type": "string"},
    "tool_permission_scope_ref": {"type": "string"},
    "agent_action_trace_ref": {"type": "string"},
    "off_history_evidence_ref": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "safety_case_ref": {"type": "string", "minLength": 1},
    "diagnosis": {"type": "string"}
  }
}
