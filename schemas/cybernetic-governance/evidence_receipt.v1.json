{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/evidence_receipt.v1.json",
  "title": "Evidence Receipt",
  "description": "Typed digest-bearing receipt for governance evidence used by traces, safety cases, promotions, releases, and public assurance artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_receipt_id", "evidence_kind", "subject_ref", "schema_ref", "content_digest", "evidence_tier", "disclosure_class", "source_ref", "implements_invariants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_receipt_id": {"type": "string", "minLength": 1},
    "evidence_kind": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "schema_ref": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "minLength": 1},
    "digest_algorithm": {"type": "string", "default": "sha256"},
    "evidence_tier": {"$ref": "enums.v1.json#/$defs/evidence_tier"},
    "disclosure_class": {"$ref": "enums.v1.json#/$defs/evidence_disclosure_class"},
    "source_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "replay_ref": {"type": "string"},
    "redaction_ref": {"type": "string"},
    "non_claim_refs": {"type": "array", "items": {"type": "string"}},
    "implements_invariants": {"type": "array", "minItems": 1, "items": {"$ref": "enums.v1.json#/$defs/constitutional_invariant_id"}}
  },
  "examples": [{"schema_version": "1.0", "evidence_receipt_id": "receipt:demo:1", "evidence_kind": "synthetic_fixture", "subject_ref": "trace:demo:1", "schema_ref": "agent_action_trace.v1.json", "content_digest": "sha256:demo", "evidence_tier": "E1_typed_occurrence", "disclosure_class": "public", "source_ref": "repo:ProCybernetica", "implements_invariants": ["invariant_0_4_digital_typed_digestible_evidence"]}]
}
