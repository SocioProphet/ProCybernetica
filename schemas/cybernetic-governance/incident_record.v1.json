{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/incident_record.v1.json",
  "title": "Incident Record",
  "description": "Governance record for a failure, drift, contradiction, monitor issue, evidence issue, release regression, authority issue, or runtime side effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incident_record_id", "incident_class", "severity", "subject_ref", "summary", "detected_at", "authority_chain_ref", "evidence_receipt_refs", "status", "implements_invariants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "incident_record_id": {"type": "string", "minLength": 1},
    "incident_class": {"$ref": "enums.v1.json#/$defs/incident_class"},
    "severity": {"$ref": "enums.v1.json#/$defs/severity_tier"},
    "subject_ref": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "detected_at": {"type": "string", "minLength": 1},
    "authority_chain_ref": {"type": "string", "minLength": 1},
    "action_trace_refs": {"type": "array", "items": {"type": "string"}},
    "monitor_alert_refs": {"type": "array", "items": {"type": "string"}},
    "off_history_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["open", "triaged", "mitigated", "resolved", "quarantined", "archived"]},
    "promotion_blocking": {"type": "boolean"},
    "lessons_ref": {"type": "string"},
    "implements_invariants": {"type": "array", "minItems": 1, "items": {"$ref": "enums.v1.json#/$defs/constitutional_invariant_id"}}
  },
  "examples": [{"schema_version": "1.0", "incident_record_id": "incident:demo:1", "incident_class": "evidence_failure", "severity": "medium", "subject_ref": "receipt:demo:1", "summary": "Synthetic evidence receipt missing required digest in invalid fixture.", "detected_at": "2026-01-01T00:00:00Z", "authority_chain_ref": "authority:demo:1", "evidence_receipt_refs": ["receipt:demo:1"], "status": "triaged", "promotion_blocking": true, "implements_invariants": ["invariant_0_4_digital_typed_digestible_evidence"]}]
}
