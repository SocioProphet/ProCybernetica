{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/interpretant_candidate.v1.json",
  "title": "Interpretant Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interpretant_id", "observation_ref", "interpretant_kind", "candidate_rendering", "confusable_with", "evidence_basis", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "interpretant_id": {"type": "string", "pattern": "^rcg:interpretant:[a-z0-9][a-z0-9_.:-]*$"},
    "observation_ref": {"type": "string", "pattern": "^rcg:observation:[a-z0-9][a-z0-9_.:-]*$"},
    "interpretant_kind": {"enum": ["instruction", "claim", "preference", "threat", "approval", "refusal", "relation", "state_change", "correction", "evidence", "action_request", "projection_reading"]},
    "candidate_rendering": {"type": "string", "minLength": 1},
    "confusable_with": {"type": "array", "items": {"type": "string"}},
    "evidence_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence_level": {"enum": ["low", "medium", "high", "unknown"], "default": "unknown"},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  }
}
