{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/monitor_alert.v1.json",
  "title": "Monitor Alert",
  "description": "Alert emitted by an independent monitor over a governed node, action, artifact, or release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "monitor_alert_id", "monitor_ref", "subject_ref", "alert_state", "severity", "summary", "evidence_receipt_refs", "implements_invariants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "monitor_alert_id": {"type": "string", "minLength": 1},
    "monitor_ref": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "alert_state": {"$ref": "enums.v1.json#/$defs/monitor_output_state"},
    "severity": {"$ref": "enums.v1.json#/$defs/severity_tier"},
    "summary": {"type": "string", "minLength": 1},
    "detected_at": {"type": "string"},
    "calibration_ref": {"type": "string"},
    "meta_monitor_report_ref": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "implements_invariants": {"type": "array", "minItems": 1, "items": {"$ref": "enums.v1.json#/$defs/constitutional_invariant_id"}}
  },
  "examples": [{"schema_version": "1.0", "monitor_alert_id": "alert:demo:1", "monitor_ref": "monitor:policy", "subject_ref": "trace:demo:1", "alert_state": "pass", "severity": "info", "summary": "Synthetic trace passed policy monitor.", "evidence_receipt_refs": ["receipt:demo:1"], "implements_invariants": ["invariant_0_6_monitor_independence"]}]
}
