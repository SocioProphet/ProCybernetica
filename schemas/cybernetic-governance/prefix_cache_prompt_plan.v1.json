{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/prefix_cache_prompt_plan.v1.json",
  "title": "Prefix Cache Prompt Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_plan_id", "workload_signature_ref", "cache_strategy", "sections", "breakpoints", "evidence_receipt_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "prompt_plan_id": {"type": "string", "minLength": 1},
    "workload_signature_ref": {"type": "string", "minLength": 1},
    "cache_strategy": {"enum": ["none", "static_before_dynamic", "section_breakpoints", "trajectory_append_only"]},
    "sections": {"type": "array", "minItems": 1, "items": {"enum": ["system", "tool_definitions", "few_shot_examples", "persistent_task_spec", "retrieved_context", "trajectory_history", "current_step_request"]}},
    "breakpoints": {"type": "array", "items": {"type": "string"}},
    "volatile_fields_excluded": {"type": "boolean"},
    "canonical_tool_result_formatting": {"type": "boolean"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
