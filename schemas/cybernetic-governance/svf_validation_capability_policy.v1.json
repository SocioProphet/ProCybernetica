{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/svf_validation_capability_policy.v1.json",
  "title": "SVF Validation Capability Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "owner",
    "actor_classes",
    "allowed_backends",
    "max_side_effects",
    "network_modes",
    "credential_modes",
    "filesystem_roots",
    "production_environment_allowed",
    "human_approval_required",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"type": "string", "pattern": "^svf:policy:[a-z0-9][a-z0-9_.:-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "repo"],
      "properties": {
        "plane": {"type": "string", "minLength": 1},
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
      }
    },
    "actor_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["human_operator", "coding_agent", "ci_runner", "workspace_runner", "platform_service"]}
    },
    "allowed_backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["local", "container", "cluster_sandbox", "qemu_sandbox", "browser_sandbox", "placeholder"]}
    },
    "max_side_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["read_only", "write_temp", "write_workspace", "write_repo"]}
    },
    "network_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["network_none", "network_allowlisted"]}
    },
    "credential_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["credential_none", "credential_read_scoped"]}
    },
    "filesystem_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "production_environment_allowed": {"const": false},
    "human_approval_required": {"type": "boolean"},
    "required_receipt_fields": {"type": "array", "items": {"type": "string"}, "default": []},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  }
}
