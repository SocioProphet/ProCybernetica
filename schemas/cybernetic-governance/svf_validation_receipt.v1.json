{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/svf_validation_receipt.v1.json",
  "title": "SVF Validation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_ref",
    "run_digest",
    "plan_ref",
    "plan_digest",
    "policy_ref",
    "policy_digest",
    "input_digests",
    "output_digests",
    "certified_claims",
    "non_certified_claims",
    "verification",
    "issued_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^svf:receipt:[a-z0-9][a-z0-9_.:-]*$"},
    "run_ref": {"type": "string", "pattern": "^svf:run:[a-z0-9][a-z0-9_.:-]*$"},
    "run_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512"]},
        "digest": {"type": "string", "minLength": 16}
      }
    },
    "plan_ref": {"type": "string", "pattern": "^svf:plan:[a-z0-9][a-z0-9_.:-]*$"},
    "plan_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512"]},
        "digest": {"type": "string", "minLength": 16}
      }
    },
    "policy_ref": {"type": "string", "pattern": "^svf:policy:[a-z0-9][a-z0-9_.:-]*$"},
    "policy_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512"]},
        "digest": {"type": "string", "minLength": 16}
      }
    },
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "algorithm", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "algorithm": {"enum": ["sha256", "sha512"]},
          "digest": {"type": "string", "minLength": 16}
        }
      }
    },
    "output_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "algorithm", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "algorithm": {"enum": ["sha256", "sha512"]},
          "digest": {"type": "string", "minLength": 16}
        }
      }
    },
    "certified_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["schema_conformant", "fixtures_validated", "tests_passed", "semantic_roundtrip_preserved", "policy_boundary_preserved", "non_production_only", "runtime_smoke_passed", "artifact_integrity_verified", "receipt_integrity_verified"]}
    },
    "non_certified_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifier", "verified_at"],
      "properties": {
        "status": {"enum": ["verified", "failed", "not_checked"]},
        "verifier": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "diagnostics": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "provenance_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "signature": {"type": "object", "default": {}}
  }
}
