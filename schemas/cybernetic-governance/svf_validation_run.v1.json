{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/svf_validation_run.v1.json",
  "title": "SVF Validation Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_ref",
    "plan_version",
    "policy_ref",
    "repo",
    "ref",
    "input_digests",
    "actor",
    "backend",
    "started_at",
    "ended_at",
    "status",
    "action_results"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^svf:run:[a-z0-9][a-z0-9_.:-]*$"},
    "plan_ref": {"type": "string", "pattern": "^svf:plan:[a-z0-9][a-z0-9_.:-]*$"},
    "plan_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_ref": {"type": "string", "pattern": "^svf:policy:[a-z0-9][a-z0-9_.:-]*$"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "ref": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "branch": {"type": "string"},
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "algorithm", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "algorithm": {"enum": ["sha256", "sha512"]},
          "digest": {"type": "string", "minLength": 16}
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_class", "actor_id"],
      "properties": {
        "actor_class": {"enum": ["human_operator", "coding_agent", "ci_runner", "workspace_runner", "platform_service"]},
        "actor_id": {"type": "string", "minLength": 1}
      }
    },
    "backend": {"enum": ["local", "container", "cluster_sandbox", "qemu_sandbox", "browser_sandbox", "placeholder"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail", "inconclusive", "not_configured"]},
    "action_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action_ref", "status", "started_at", "ended_at", "diagnostics"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "action_ref": {"type": "string", "pattern": "^svf:action:[a-z0-9][a-z0-9_.:-]*$"},
          "status": {"enum": ["pass", "fail", "inconclusive", "not_configured"]},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "diagnostics": {"type": "array", "items": {"type": "string"}},
          "artifact_refs": {"type": "array", "items": {"type": "string"}, "default": []}
        }
      }
    },
    "logs": {"type": "array", "items": {"type": "string"}, "default": []},
    "non_claims": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
