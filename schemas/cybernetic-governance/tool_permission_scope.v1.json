{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/cybernetic-governance/tool_permission_scope.v1.json",
  "title": "Tool Permission Scope",
  "description": "Declared authority boundary for a tool, adapter, service, or execution surface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "permission_scope_id", "tool_ref", "subject_ref", "allowed_operations", "denied_operations", "authority_chain_ref", "side_effect_limit", "implements_invariants"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "permission_scope_id": {"type": "string", "minLength": 1},
    "tool_ref": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "allowed_operations": {"type": "array", "items": {"type": "string"}},
    "denied_operations": {"type": "array", "items": {"type": "string"}},
    "authority_chain_ref": {"type": "string", "minLength": 1},
    "side_effect_limit": {"$ref": "enums.v1.json#/$defs/reversibility_class"},
    "network_allowed": {"type": "boolean"},
    "filesystem_write_allowed": {"type": "boolean"},
    "credential_access_allowed": {"type": "boolean"},
    "approval_required": {"type": "boolean"},
    "expires_at": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "items": {"type": "string"}},
    "implements_invariants": {"type": "array", "minItems": 1, "items": {"$ref": "enums.v1.json#/$defs/constitutional_invariant_id"}}
  },
  "examples": [{"schema_version": "1.0", "permission_scope_id": "scope:demo:1", "tool_ref": "tool:mock", "subject_ref": "agent:demo", "allowed_operations": ["read"], "denied_operations": ["write", "network"], "authority_chain_ref": "authority:demo:1", "side_effect_limit": "fully_reversible", "network_allowed": false, "filesystem_write_allowed": false, "credential_access_allowed": false, "approval_required": false, "implements_invariants": ["invariant_0_1_no_hidden_authority_lane", "invariant_0_7_irreversibility_requires_approval"]}]
}
