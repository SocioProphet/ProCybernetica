{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/procybernetica/governance-fabric/agent_action_trace.v1.json",
  "title": "Tier 1 Agent Action Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificate_kind", "action_trace_id", "created_at", "execution_status", "actor", "action", "authority_chain_ref", "tool_permission_scope_ref", "inputs_ref", "outputs_ref", "decision", "evidence_refs", "off_history_refs", "ledger_entry"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "certificate_kind": {"const": "agent_action_trace"},
    "action_trace_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_status": {"enum": ["doctrine_only", "synthetic_fixture", "runtime_partial", "runtime_executed", "failed"]},
    "actor": {"$ref": "#/$defs/actor"},
    "action": {"type": "object", "additionalProperties": false, "required": ["action_type", "description", "irreversibility_class"], "properties": {"action_type": {"type": "string"}, "description": {"type": "string"}, "irreversibility_class": {"enum": ["reversible", "costly_to_reverse", "irreversible"]}}},
    "authority_chain_ref": {"$ref": "#/$defs/authority_ref"},
    "tool_permission_scope_ref": {"$ref": "#/$defs/tool_scope_ref"},
    "inputs_ref": {"type": "string"},
    "outputs_ref": {"type": "string"},
    "decision": {"enum": ["allowed", "blocked", "transformed", "requires_approval", "failed"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "off_history_refs": {"type": "array", "items": {"$ref": "#/$defs/off_history_ref"}},
    "ledger_entry": {"$ref": "#/$defs/ledger_entry"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["actor_id", "actor_kind"], "properties": {"actor_id": {"type": "string"}, "actor_kind": {"enum": ["human", "agent", "service", "pipeline", "organization", "role"]}}},
    "authority_ref": {"type": "object", "additionalProperties": false, "required": ["authority_chain_id", "authority_chain_sha256"], "properties": {"authority_chain_id": {"type": "string"}, "authority_chain_sha256": {"$ref": "#/$defs/sha256"}}},
    "tool_scope_ref": {"type": "object", "additionalProperties": false, "required": ["tool_permission_scope_id", "tool_permission_scope_sha256"], "properties": {"tool_permission_scope_id": {"type": "string"}, "tool_permission_scope_sha256": {"$ref": "#/$defs/sha256"}}},
    "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["evidence_receipt_id", "evidence_receipt_sha256"], "properties": {"evidence_receipt_id": {"type": "string"}, "evidence_receipt_sha256": {"$ref": "#/$defs/sha256"}}},
    "off_history_ref": {"type": "object", "additionalProperties": false, "required": ["off_history_id", "off_history_sha256"], "properties": {"off_history_id": {"type": "string"}, "off_history_sha256": {"$ref": "#/$defs/sha256"}}},
    "ledger_entry": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "created_at"], "properties": {"event_id": {"type": "string"}, "event_type": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}}
  }
}
