{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/procybernetica/governance-fabric/cybernetic_safety_case.v1.json",
  "title": "Tier 1 Cybernetic Safety Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificate_kind", "safety_case_id", "created_at", "execution_status", "claim", "scope", "evidence_receipt_refs", "authority_chain_ref", "monitor_alert_refs", "off_history_refs", "non_claims", "residual_risks", "ledger_entry"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "certificate_kind": {"const": "cybernetic_safety_case"},
    "safety_case_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_status": {"enum": ["doctrine_only", "synthetic_fixture", "runtime_partial", "runtime_executed", "failed"]},
    "claim": {"type": "string"},
    "scope": {"type": "string"},
    "evidence_receipt_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "authority_chain_ref": {"$ref": "#/$defs/authority_ref"},
    "monitor_alert_refs": {"type": "array", "items": {"$ref": "#/$defs/monitor_ref"}},
    "off_history_refs": {"type": "array", "items": {"$ref": "#/$defs/off_history_ref"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "ledger_entry": {"$ref": "#/$defs/ledger_entry"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority_ref": {"type": "object", "additionalProperties": false, "required": ["authority_chain_id", "authority_chain_sha256"], "properties": {"authority_chain_id": {"type": "string"}, "authority_chain_sha256": {"$ref": "#/$defs/sha256"}}},
    "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["evidence_receipt_id", "evidence_receipt_sha256"], "properties": {"evidence_receipt_id": {"type": "string"}, "evidence_receipt_sha256": {"$ref": "#/$defs/sha256"}}},
    "monitor_ref": {"type": "object", "additionalProperties": false, "required": ["monitor_alert_id", "monitor_alert_sha256"], "properties": {"monitor_alert_id": {"type": "string"}, "monitor_alert_sha256": {"$ref": "#/$defs/sha256"}}},
    "off_history_ref": {"type": "object", "additionalProperties": false, "required": ["off_history_id", "off_history_sha256"], "properties": {"off_history_id": {"type": "string"}, "off_history_sha256": {"$ref": "#/$defs/sha256"}}},
    "ledger_entry": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "created_at"], "properties": {"event_id": {"type": "string"}, "event_type": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}}
  }
}
