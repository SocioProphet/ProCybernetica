{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/procybernetica/governance-fabric/evidence_receipt.v1.json",
  "title": "Tier 1 Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificate_kind", "evidence_receipt_id", "created_at", "execution_status", "evidence_kind", "subject_ref", "content_hash", "privacy", "producer", "counterfactuals_addressable", "ledger_entry"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "certificate_kind": {"const": "evidence_receipt"},
    "evidence_receipt_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_status": {"enum": ["doctrine_only", "synthetic_fixture", "runtime_partial", "runtime_executed", "failed"]},
    "evidence_kind": {"enum": ["interpretability_certificate", "trace", "source_lock", "monitor_alert", "off_history", "release_delta", "safety_case", "test_result", "schema_fixture", "other"]},
    "subject_ref": {"type": "string"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "producer": {"$ref": "#/$defs/actor"},
    "counterfactuals_addressable": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["question_id", "evidence_path", "answer_form"], "properties": {"question_id": {"type": "string", "pattern": "^cf-[a-z0-9-]+$"}, "evidence_path": {"type": "string"}, "answer_form": {"enum": ["boolean", "hash_match", "numerical_range", "categorical", "structured"]}}}},
    "ledger_entry": {"$ref": "#/$defs/ledger_entry"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["actor_id", "actor_kind"], "properties": {"actor_id": {"type": "string"}, "actor_kind": {"enum": ["human", "agent", "service", "pipeline", "organization", "role"]}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["privacy_class", "evidence_mode", "minimization_rationale"], "properties": {"privacy_class": {"enum": ["P0_public", "P1_internal", "P2_sensitive", "P3_sealed", "P4_non_retainable_raw"]}, "evidence_mode": {"enum": ["raw", "redacted", "hashed", "committed", "aggregated", "sealed_witness", "zero_knowledge"]}, "minimization_rationale": {"type": "string"}}},
    "ledger_entry": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "created_at"], "properties": {"event_id": {"type": "string"}, "event_type": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}}
  }
}
