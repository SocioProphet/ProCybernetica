{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/procybernetica/mfel/evidence-graph.schema.json",
  "title": "MFEL Evidence Graph",
  "description": "Public-safe evidence graph connecting observed facts, derived facts, interpretations, hypotheses, and prohibited conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "case_id",
    "publication_state",
    "redaction_boundary",
    "nodes",
    "edges",
    "graph_invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "mfel.evidence_graph.v1"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^graph-[A-Za-z0-9._:-]+$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "publication_state": {
      "enum": [
        "public",
        "public-sanitized",
        "public-synthetic"
      ]
    },
    "redaction_boundary": {
      "$ref": "#/$defs/redaction_boundary"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "graph_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_separation_enforced",
        "unsupported_actor_attribution_rejected",
        "redaction_boundary_present",
        "prohibited_conclusions_present"
      ],
      "properties": {
        "layer_separation_enforced": {
          "const": true
        },
        "unsupported_actor_attribution_rejected": {
          "const": true
        },
        "redaction_boundary_present": {
          "const": true
        },
        "prohibited_conclusions_present": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "redaction_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "private_evidence_policy",
        "public_substitute"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "public-sanitized",
            "public-synthetic"
          ]
        },
        "private_evidence_policy": {
          "type": "string",
          "minLength": 1
        },
        "public_substitute": {
          "enum": [
            "method",
            "schema",
            "sanitized_summary",
            "synthetic_fixture",
            "redacted_excerpt",
            "none"
          ]
        },
        "withheld_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "label",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(obs|drv|int|hyp|pc)-[A-Za-z0-9._:-]+$"
        },
        "layer": {
          "enum": [
            "observed_fact",
            "derived_fact",
            "interpretation",
            "hypothesis",
            "prohibited_conclusion"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string"
        },
        "risk_level": {
          "enum": [
            "low",
            "moderate",
            "suspicious",
            "high"
          ]
        },
        "status": {
          "enum": [
            "live",
            "disfavored",
            "unsupported",
            "supported",
            "rejected",
            "prohibited"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^obs-"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "layer": {
                "const": "observed_fact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^drv-"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "layer": {
                "const": "derived_fact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^int-"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "layer": {
                "const": "interpretation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^hyp-"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "layer": {
                "const": "hypothesis"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "pattern": "^pc-"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "layer": {
                "const": "prohibited_conclusion"
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(obs|drv|int|hyp|pc)-[A-Za-z0-9._:-]+$"
        },
        "to": {
          "type": "string",
          "pattern": "^(obs|drv|int|hyp|pc)-[A-Za-z0-9._:-]+$"
        },
        "relation": {
          "enum": [
            "supports",
            "refutes",
            "derives_from",
            "interprets",
            "requires_missing_evidence",
            "prohibits",
            "contextualizes"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}
