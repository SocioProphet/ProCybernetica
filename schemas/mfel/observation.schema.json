{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/procybernetica/mfel/observation.schema.json",
  "title": "MFEL Observation Case",
  "description": "Metadata Forensics and Epistemic Learning case record. Enforces separation among observed facts, derived facts, interpretations, hypotheses, and prohibited conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "publication_state",
    "redaction_boundary",
    "subject",
    "observed_facts",
    "derived_facts",
    "interpretations",
    "hypotheses",
    "prohibited_conclusions",
    "negative_evidence",
    "missing_evidence",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "mfel.observation.v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publication_state": {
      "enum": [
        "public",
        "public-sanitized",
        "public-synthetic"
      ]
    },
    "source_class": {
      "enum": [
        "macos_metadata",
        "epistemic_threat",
        "mixed"
      ],
      "default": "mixed"
    },
    "redaction_boundary": {
      "$ref": "#/$defs/redaction_boundary"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_kind",
        "scope"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_kind": {
          "enum": [
            "file",
            "plist",
            "process",
            "journal",
            "message",
            "rhetorical_artifact",
            "metadata_cluster",
            "synthetic_case",
            "other"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "time_window": {
          "type": "string"
        }
      }
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observed_fact"
      }
    },
    "derived_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/derived_fact"
      }
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interpretation"
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hypothesis_ref"
      }
    },
    "prohibited_conclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prohibited_conclusion"
      }
    },
    "negative_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "redaction_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "private_evidence_policy",
        "public_substitute",
        "withheld_fields"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "public-sanitized",
            "public-synthetic"
          ]
        },
        "private_evidence_policy": {
          "type": "string",
          "minLength": 1
        },
        "public_substitute": {
          "enum": [
            "method",
            "schema",
            "sanitized_summary",
            "synthetic_fixture",
            "redacted_excerpt",
            "none"
          ]
        },
        "withheld_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redaction_rationale": {
          "type": "string"
        }
      }
    },
    "observed_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "statement",
        "source",
        "evidence_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^obs-[A-Za-z0-9._:-]+$"
        },
        "layer": {
          "const": "observed_fact"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "filesystem_metadata",
            "plist_key",
            "log_excerpt",
            "journal_entry",
            "microstackshot_summary",
            "rhetorical_text",
            "synthetic_fixture",
            "sanitized_case_note",
            "other"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string"
        },
        "confidence_bound": {
          "enum": [
            "direct_observation",
            "sanitized_summary",
            "synthetic",
            "unknown"
          ]
        }
      }
    },
    "derived_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "statement",
        "derivation",
        "input_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^drv-[A-Za-z0-9._:-]+$"
        },
        "layer": {
          "const": "derived_fact"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "confidence_bound": {
          "enum": [
            "deterministic",
            "bounded",
            "heuristic",
            "unknown"
          ]
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "statement",
        "basis_refs",
        "confidence_bound",
        "alternative_explanations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^int-[A-Za-z0-9._:-]+$"
        },
        "layer": {
          "const": "interpretation"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "confidence_bound": {
          "enum": [
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        },
        "alternative_explanations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hypothesis_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "statement",
        "risk_level",
        "supporting_refs",
        "negative_evidence",
        "missing_evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^hyp-[A-Za-z0-9._:-]+$"
        },
        "layer": {
          "const": "hypothesis"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "moderate",
            "suspicious",
            "high"
          ]
        },
        "supporting_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "live",
            "disfavored",
            "unsupported",
            "supported",
            "rejected"
          ],
          "default": "live"
        }
      }
    },
    "prohibited_conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "statement",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pc-[A-Za-z0-9._:-]+$"
        },
        "layer": {
          "const": "prohibited_conclusion"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_ref",
        "to_ref",
        "relation"
      ],
      "properties": {
        "from_ref": {
          "type": "string"
        },
        "to_ref": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "refutes",
            "derives_from",
            "interprets",
            "prohibits",
            "requires_missing_evidence"
          ]
        }
      }
    }
  }
}
