{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.procybernetica.local/procybernetica/cleavage-operation.v0.1.schema.json",
  "title": "ProCybernetica Cleavage Operation v0.1",
  "description": "Structural deterministic-cleavage operation record. Requires a cartesian lift witness, cleavage version, and canonical governance tokens carrying projection and admissibility roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cleavage_operation_id",
    "cleavage_version",
    "source_base_context_ref",
    "target_base_context_ref",
    "source_fiber_ref",
    "target_fiber_ref",
    "base_morphism_ref",
    "lift_witness",
    "canonical_tokens",
    "theorem_audit_refs"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "cleavage_operation_id": {"type": "string", "minLength": 1},
    "cleavage_version": {"type": "string", "minLength": 1},
    "source_base_context_ref": {"type": "string", "minLength": 1},
    "target_base_context_ref": {"type": "string", "minLength": 1},
    "source_fiber_ref": {"type": "string", "minLength": 1},
    "target_fiber_ref": {"type": "string", "minLength": 1},
    "base_morphism_ref": {"type": "string", "minLength": 1},
    "lift_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["witness_id", "witness_kind", "witness_ref"],
      "properties": {
        "witness_id": {"type": "string", "minLength": 1},
        "witness_kind": {
          "type": "string",
          "enum": [
            "proof_sketch_ref",
            "deterministic_procedure_ref",
            "fixture_ref",
            "validation_receipt",
            "manual_review_receipt",
            "future_proof_object"
          ]
        },
        "witness_ref": {"type": "string", "minLength": 1},
        "witness_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "canonical_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/canonical_token"}
    },
    "determinism_statement": {
      "type": "string",
      "default": "same source, target, token set, policy constraints, and cleavage_version produce same representative"
    },
    "theorem_audit_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["TBD-CLEV", "TBD-GNF"]}
    },
    "non_claims": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "$defs": {
    "canonical_token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "projection_role", "admissibility_role", "cleavage_version"],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "source_token_ref": {"type": ["string", "null"]},
        "projection_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scoped_authority_kind", "sphere_target", "projection_ref"],
          "properties": {
            "scoped_authority_kind": {"type": "string", "minLength": 1},
            "sphere_target": {"type": "string", "minLength": 1},
            "projection_ref": {"type": "string", "minLength": 1}
          }
        },
        "admissibility_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_constraint_ref", "constraint_kind"],
          "properties": {
            "policy_constraint_ref": {"type": "string", "minLength": 1},
            "constraint_kind": {"type": "string", "minLength": 1},
            "admissibility_predicate": {"type": ["string", "null"]}
          }
        },
        "cleavage_version": {"type": "string", "minLength": 1},
        "normal_form_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
